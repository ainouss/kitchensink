<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ainouss.kitchensink</groupId>
        <artifactId>kitchensink-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>characterization</artifactId>
    <name>kitchensink characterization suite</name>
    <description>The legacy's behaviour (rules R1 to R18) recorded as request/response cases. They run against the
        new application in every build, or against a running system with -Dkitchensink.target=&lt;base URL&gt;.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.ainouss.kitchensink</groupId>
            <artifactId>kitchensink-app</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.ainouss.kitchensink</groupId>
            <artifactId>kitchensink-local</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
