<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The legacy kitchensink, unchanged, packaged as a WildFly bootable jar that runs on PostgreSQL.
         Not a child of the Spring Boot parent: it is the old world, built with its own dependencies. -->
    <groupId>io.github.ainouss.kitchensink</groupId>
    <artifactId>kitchensink-legacy</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>kitchensink legacy (WildFly)</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>
        <wildfly.version>42.0.0.Final</wildfly.version>
        <wildfly-datasources.version>11.5.0.Final</wildfly-datasources.version>
        <wildfly-maven-plugin.version>6.2.0.Final</wildfly-maven-plugin.version>
        <jboss-logging.version>3.6.1.Final</jboss-logging.version>
        <jboss-logging-tools.version>3.0.4.Final</jboss-logging-tools.version>
    </properties>

    <dependencies>
        <!-- Everything the code uses is provided by WildFly. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
            <version>${jboss-logging.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging-annotations</artifactId>
            <version>${jboss-logging-tools.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging-processor</artifactId>
            <version>${jboss-logging-tools.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kitchensink</finalName>
        <resources>
            <!-- The quickstart's resources, except persistence.xml, which comes from postgresql/ -->
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>META-INF/persistence.xml</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>postgresql</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <!-- The in-memory H2 datasource is replaced by the PostgreSQL one in wildfly/datasource.cli -->
                    <packagingExcludes>WEB-INF/kitchensink-quickstart-ds.xml</packagingExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>${wildfly-maven-plugin.version}</version>
                <configuration>
                    <feature-packs>
                        <feature-pack>
                            <location>org.wildfly:wildfly-galleon-pack:${wildfly.version}</location>
                        </feature-pack>
                        <feature-pack>
                            <location>org.wildfly:wildfly-datasources-galleon-pack:${wildfly-datasources.version}</location>
                        </feature-pack>
                    </feature-packs>
                    <layers>
                        <layer>cloud-server</layer>
                        <layer>jsf</layer>
                        <layer>ejb-lite</layer>
                        <layer>postgresql-driver</layer>
                    </layers>
                    <packaging-scripts>
                        <packaging-script>
                            <scripts>
                                <script>${project.basedir}/wildfly/datasource.cli</script>
                            </scripts>
                        </packaging-script>
                    </packaging-scripts>
                    <bootable-jar>true</bootable-jar>
                    <bootable-jar-name>kitchensink-legacy.jar</bootable-jar-name>
                    <skip-deployment>false</skip-deployment>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
